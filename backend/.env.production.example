# Production Backend Environment Template (DO NOT COMMIT REAL SECRETS)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=certificate_vault

JWT_SECRET_KEY=<generate-64-char-random-secret>
JWT_EXPIRE_MINUTES=60
OWNER_EMAIL=<your-owner-email>
OWNER_PASSWORD_HASH=<argon2id-hash-from-setup_owner>

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_BUCKET=certificates

FRONTEND_URL=https://your-certificatevault-domain.vercel.app
BACKEND_URL=https://api.your-certificatevault-domain.com
MAX_UPLOAD_SIZE_MB=10
