{
  "manifest_version": 3,
  "name": "CertificateVault",
  "version": "1.1.0",
  "description": "Save certificate verification links and local PDF/image files directly to your personal CertificateVault.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://certificatevault.onrender.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.coursera.org/*",
        "https://coursera.org/*",
        "https://www.freecodecamp.org/certification/*",
        "https://www.credly.com/badges/*",
        "https://www.hackerrank.com/certificates/*",
        "https://www.udemy.com/certificate/*",
        "https://www.cloudskillsboost.google/*",
        "https://www.skills.google/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to CertificateVault",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
